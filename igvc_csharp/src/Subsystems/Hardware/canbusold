using System.Collections.Concurrent;
using System.Runtime.InteropServices;
using igvc_csharp.Core;
using igvc_csharp.Core.Hardware.Canbus;
using igvc_csharp.Events;
using igvc_csharp.Subsystems.Hardware.CanLayers;
using igvc_csharp.Subsystems.Simulator;
using Microsoft.Extensions.Logging;
using SocketCANSharp;
using SocketCANSharp.Network;

namespace igvc_csharp.Subsystems.Hardware;

[Subsystem("CanbusSubsystem", DependsOn = [
    typeof(ChronosSubsystem)
])]
public class CanbusSubsystem(
    SimulatorSubsystem? simulatorSubsystem,
    ChronosSubsystem chronos
) : SubsystemBase
{
    private readonly ICanInterface _can = new SocketCanInterface(Configuration.Hardware.CanbusInterface);

    private BlockingCollection<CanFrame> _frameQueue = new(128);
    private volatile bool _connected;
    private readonly Lock _socketLock = new();

    // Reconnect backoff state
    private int _reconnectAttempts;
    private const int MaxReconnectDelayMs = 3000;
    private const int BaseReconnectDelayMs = 1000;

    // Layers
    public SafetyLightsLayer SafetyLights = null!;
    public MotorControlLayer MotorControl = null!;

    public override Task Init(CancellationToken token)
    {
        SafetyLights = new SafetyLightsLayer(this);
        MotorControl = new MotorControlLayer(this);

        // In simulation mode we still initialise layers, but skip the real socket
        if (Configuration.UseSimulation)
        {
            return Task.CompletedTask;
        }

        _ = Task.Factory.StartNew(
            () => WriteTask(token),
            token,
            TaskCreationOptions.LongRunning,
            TaskScheduler.Default
        );
        _ = Task.Factory.StartNew(
            () => ReadTask(token),
            token,
            TaskCreationOptions.LongRunning,
            TaskScheduler.Default
        );

        return Task.CompletedTask;
    }

    private bool TryConnectSocket()
    {
        lock (_socketLock)
        {
            if (_connected) return true;

            Logger.LogDebug("Attempting to open CAN interface '{Interface}'", Configuration.Hardware.CanbusInterface);

            var success = _can.TryOpen();
            if (!success)
            {
                Logger.LogDebug("CAN interface '{Interface}' not available — is it up?", Configuration.Hardware.CanbusInterface);
                return false;
            }

            _frameQueue = new BlockingCollection<CanFrame>(128);
            _connected = true;

            Logger.LogInformation("Connected to CAN interface '{Interface}'", Configuration.Hardware.CanbusInterface);
            SetOperatingState(SubsystemState.Operating);
            return true;
        }
    }

    private void TryCloseSocket()
    {
        lock (_socketLock)
        {
            if (!_connected) return; // already closed, don't double-log

            _connected = false;
            _can.Close();

            _frameQueue.CompleteAdding();
            _frameQueue.Dispose();

            if (State != SubsystemState.ShuttingDown)
            {
                SetOperatingState(SubsystemState.Idle);
                Logger.LogWarning("Disconnected from CAN interface '{Interface}', will attempt to reconnect", Configuration.Hardware.CanbusInterface);
            }
        }
    }

    private async Task TryReconnect(CancellationToken token)
    {
        var delayMs = Math.Min(
            BaseReconnectDelayMs * (1 << Math.Min(_reconnectAttempts, 10)),
            MaxReconnectDelayMs
        );

        if (_reconnectAttempts == 0)
        {
            Logger.LogInformation("Connecting to CAN interface '{Interface}'", Configuration.Hardware.CanbusInterface);
        }
        else
        {
            Logger.LogWarning("Reconnect attempt {Attempt} for '{Interface}', retrying in {Delay}ms", _reconnectAttempts, Configuration.Hardware.CanbusInterface, delayMs);
        }

        await Task.Delay(delayMs, token);

        if (TryConnectSocket())
        {
            _reconnectAttempts = 0;
        }
        else
        {
            _reconnectAttempts++;
        }
    }

    private async Task WriteTask(CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            if (!_connected)
            {
                await Task.Delay(100, token);
                continue;
            }

            CanFrame frame;
            try
            {
                if (!_frameQueue.TryTake(out frame, 100))
                {
                    continue;
                }
            }
            catch (InvalidOperationException)
            {
                continue;
            }

            try
            {
                lock (_socketLock)
                {
                    if (!_connected)
                    {
                        return;
                    }

                    _can.Write(frame);
                }

                Logger.LogDebug("Wrote CAN frame id: {FrameId}", frame.CanId);
            }
            catch (ObjectDisposedException ex)
            {
                Logger.LogWarning(ex, "CAN interface closed during write.");
                TryCloseSocket();
            }
            catch (SocketCanException ex)
            {
                Logger.LogError(ex, "SocketCAN error during write.");
                TryCloseSocket();
            }
        }
    }

    private async Task ReadTask(CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            if (!_connected)
            {
                await TryReconnect(token);
                continue;
            }

            try
            {
                CanFrame frame;
                lock (_socketLock)
                {
                    if (!_connected)
                    {
                        continue;
                    }

                    var bytesRead = _can.Read(out frame);
                    if (bytesRead == 0)
                    {
                        continue;
                    }
                }

                chronos.WriteCan(frame);
                EventBus.Instance.Publish(new CanFrameEvent(frame));
            }
            catch (ObjectDisposedException ex)
            {
                Logger.LogWarning(ex, "CAN interface closed during read.");
                TryCloseSocket();
            }
            catch (SocketCanException ex)
            {
                Logger.LogError(ex, "SocketCAN error during read.");
                TryCloseSocket();
            }
        }
    }

    public void SendCanFrame(CanFrame frame)
    {
        if (Configuration.UseSimulation)
        {
            simulatorSubsystem?.SendCanFrame(frame);
            return;
        }

        if (!_connected)
            return;

        if (_frameQueue.IsAddingCompleted)
            return;

        try
        {
            _frameQueue.TryAdd(frame);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogCritical(ex, "Canbus frame queue is full.");
        }
    }

    public override Task Shutdown()
    {
        SetOperatingState(SubsystemState.ShuttingDown);
        TryCloseSocket();
        _can.Dispose();
        SetOperatingState(SubsystemState.Shutdown);
        return Task.CompletedTask;
    }

    public static byte[] PacketToBytes<T>(T packet) where T : struct
    {
        var bytes = new byte[Marshal.SizeOf<T>()];
        MemoryMarshal.Write(bytes.AsSpan(), packet);
        return bytes;
    }

    public static T PacketFromBytes<T>(byte[] bytes) where T : struct
    {
        return MemoryMarshal.Read<T>(bytes.AsSpan());
    }
}