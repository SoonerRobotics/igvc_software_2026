namespace {NAMESPACE_PLACEHOLDER};

table ImageFrame {
    // The timestamp of the image frame in microseconds
    timestamp: ulong;

    // The sequence number of the image frame
    sequence_number: uint;

    // The width and height of the image
    width: uint;
    height: uint;

    // The encoding format of the image (e.g., "RGB8", "BGR8", "GRAY8")
    encoding: string;

    // The image identifier (e.g., "camera_front", "camera_rear")
    identifier: string;

    // The raw image data
    image_data: [ubyte];
}

root_type ImageFrame;