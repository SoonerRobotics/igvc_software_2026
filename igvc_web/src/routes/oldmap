<!-- src/routes/map/+page.svelte -->
<script lang="ts">
    import MapView from "../components/map.svelte";
    import { LOCATIONS, DEFAULT_LOCATION } from "$lib/config/locations";
    import type { MapLocation } from "$lib/config/locations";

    let selected: MapLocation = $state(DEFAULT_LOCATION);
</script>

<div class="h-full w-full flex-1 flex flex-col gap-4 p-4">
    <div>
        {#each LOCATIONS as loc}
            <button
                class:active={selected.id === loc.id}
                onclick={() => (selected = loc)}
            >
                {loc.name}
            </button>
        {/each}
    </div>

    <div class="min-h-full w-full flex flex-col flex-1">
        <MapView location={selected} />
    </div>
</div>
