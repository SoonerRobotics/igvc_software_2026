SUBSYSTEM=="net", ACTION=="add", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="606f", \
    RUN+="/bin/sh -c 'sleep 1 && /usr/sbin/ip link set can0 type can bitrate 125000'", \
    RUN+="/bin/sh -c 'sleep 1 && /usr/sbin/ip link set can0 up'"
    
# slcan — pass the real kernel name (ttyACM0), not the symlink
KERNEL=="ttyACM*", ATTRS{idVendor}=="ad50", ATTRS{idProduct}=="60c4", \
    MODE:="0666", GROUP:="dialout", SYMLINK+="igvc-slcan0", \
    ACTION=="add", RUN+="/bin/systemctl start igvc-can-slcan@%k.service"

KERNEL=="ttyACM*", ATTRS{idVendor}=="ad50", ATTRS{idProduct}=="60c4", \
    ACTION=="remove", RUN+="/bin/systemctl stop igvc-can-slcan@%k.service"

# IMU/GPS
KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="AU057VHW", MODE:="0666", GROUP:="dialout", SYMLINK+="igvc-vn"
KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="AU05RFV7", MODE:="0666", GROUP:="dialout", SYMLINK+="igvc-vn"

# Cameras
KERNEL=="video*", ATTRS{idVendor}=="32e4", ATTRS{idProduct}=="0234", ENV{ID_PATH}=="platform-3610000.usb-usb-0:2.1.2:1.0", ENV{ID_V4L_CAPABILITIES}==":capture:", SYMLINK+="igvc-cam-left", MODE:="0666", GROUP:="video"
KERNEL=="video*", ATTRS{idVendor}=="32e4", ATTRS{idProduct}=="0234", ENV{ID_PATH}=="platform-3610000.usb-usb-0:2.1.4:1.0", ENV{ID_V4L_CAPABILITIES}==":capture:", SYMLINK+="igvc-cam-right", MODE:="0666", GROUP:="video"