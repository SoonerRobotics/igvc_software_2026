# Candlelight CAN
SUBSYSTEM=="net", ACTION=="add", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="606f", NAME="igvc-can0", RUN+="/sbin/ip link set igvc-can0 type can bitrate 100000", RUN+="/sbin/ip link set igvc-can0 up"

# SlCAN
KERNEL=="ttyACM*", ATTRS{idVendor}=="ad50", ATTRS{idProduct}=="60c4", MODE:="0666", GROUP:="dialout", SYMLINK+="autonav-can-scr", TAG+="systemd", ENV{SYSTEMD_WANTS}+="slcan@igvc-can.service"

# IMU/GPS
KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="AU057VHW", MODE:="0666", GROUP:="dialout", SYMLINK+="igvc-vn"
KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="AU05RFV7", MODE:="0666", GROUP:="dialout", SYMLINK+="igvc-vn"